// 1. Add this Enum at the top of your file
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The 'url' line is removed from here
}


enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String
  firstName     String?
  lastName      String?   
  phoneNumber   String?
  password      String
  role          Role      @default(USER) // 2. Add this line. Default is regular user.
  totalBalance  Float     @default(0.0) 
  assets        Asset[]
  createdAt     DateTime  @default(now())
}




model Asset {
  id            String   @id @default(cuid())
  symbol        String   // e.g., "BTC"
  name          String   // e.g., "Bitcoin"
  amount        Float    @default(0.0)
  walletAddress String?  // New Field: Admin sets this manually
  userId        String
  user          User     @relation(fields: [userId], references: [id])
}